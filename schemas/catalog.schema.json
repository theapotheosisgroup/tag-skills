{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theapotheosisgroup/tag-skills/schemas/catalog.schema.json",
  "title": "Generated catalog (catalog.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "generatedBy", "repository", "skills", "profiles"],
  "properties": {
    "catalogVersion": { "const": 1 },
    "generatedBy": { "type": "string" },
    "repository": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "path",
          "version",
          "domain",
          "priority",
          "audiences",
          "invocation",
          "sideEffects",
          "capabilities",
          "dependencies",
          "provenance",
          "contentHash"
        ],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "path": { "type": "string" },
          "version": { "type": "string" },
          "domain": { "type": "string" },
          "priority": { "type": "string" },
          "audiences": { "type": "array", "items": { "type": "string" } },
          "invocation": { "type": "string" },
          "sideEffects": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": "array", "items": { "type": "string" } },
          "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "skills"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
