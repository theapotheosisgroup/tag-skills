{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theapotheosisgroup/tag-skills/schemas/upstreams-lock.schema.json",
  "title": "TAG upstream import record (upstreams.lock.json)",
  "description": "TAG's own record of where each forked skill came from. Not the Skills CLI's consumer skills-lock.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockfileVersion", "sources", "imports", "blocked"],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    }
  },
  "properties": {
    "lockfileVersion": { "const": 1 },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "commit", "licence", "copyright", "notices"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
          "commit": { "$ref": "#/$defs/sha" },
          "licence": { "type": "string" },
          "copyright": { "type": "string" },
          "notices": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "commit",
          "path",
          "licence",
          "licenceFile",
          "notices",
          "originalName",
          "tagName",
          "destination",
          "importDate",
          "sourceHash",
          "files",
          "excludedFiles",
          "dependencyPaths",
          "adaptations"
        ],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "commit": { "$ref": "#/$defs/sha" },
          "path": { "type": "string" },
          "licence": { "type": "string" },
          "licenceFile": { "type": "string" },
          "notices": { "type": "array", "items": { "type": "string" } },
          "originalName": { "type": "string" },
          "tagName": { "type": "string" },
          "destination": { "type": "string" },
          "importDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sourceHash": { "$ref": "#/$defs/hash" },
          "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
          "excludedFiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason"],
              "properties": { "path": { "type": "string" }, "reason": { "type": "string" } }
            }
          },
          "dependencyPaths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "use"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "use": { "type": "string" }
              }
            }
          },
          "adaptations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "reason", "status"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "path": { "type": "string" },
          "reason": { "type": "string" },
          "status": { "enum": ["excluded", "blocked"] }
        }
      }
    }
  }
}
