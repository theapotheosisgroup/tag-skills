{
  "name": "tag-skills",
  "version": "0.0.0",
  "private": true,
  "description": "TAG's installable Agent Skills: a 16-skill back-office G&A catalog (Finance, People, Governance) with validation, provenance, profiles and Skills CLI installation tests.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "node scripts/validate-skills.js && node scripts/validate-skills.js --fixtures tests/fixtures/skills",
    "catalog:generate": "node scripts/catalog.js",
    "catalog:check": "node scripts/catalog.js --check",
    "test": "node --test tests/",
    "test:install": "node scripts/smoke-skills-cli.js",
    "test:smoke": "npm run validate && npm run catalog:check && npm run test:install",
    "upstream:check": "node scripts/upstream-check.js",
    "install:profile": "node scripts/install-profile.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "skills": "1.9.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
